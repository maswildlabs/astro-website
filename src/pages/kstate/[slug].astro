---
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const markdownFiles = import.meta.glob('../../content/kstate/*.md', { eager: true });
  
  return Object.entries(markdownFiles).map(([path, file]) => {
    const cleanSlug = path.split('/').pop().replace(/\.md$/, '');
    return {
      params: { slug: cleanSlug },
      props: { file }
    };
  });
}

const { file } = Astro.props;
const { Content } = file;
const frontmatter = file.frontmatter || {};
---

<SiteLayout title={`${frontmatter.title || "K-State Coursework Documentation"}`}>
  <main style="background-color: #141414; min-height: 100vh; color: #ffffff; padding: 4rem 1.5rem; font-family: system-ui, sans-serif;">
    <div style="max-width: 50rem; margin: 0 auto;">
      
      <nav style="font-family: monospace; font-size: 0.75rem; display: flex !important; gap: 0.5rem !important; align-items: center !important; color: #98BF92 !important; opacity: 1 !important; margin-bottom: 2rem;">
        <a href="/" style="text-decoration: none !important; color: #98BF92 !important; opacity: 1 !important;">HOME</a>
        <span style="color: #98BF92 !important; opacity: 1 !important;">/</span> 
        {/* MATCHING ROUTE: /kstate */}
        <a href="/kstate" style="text-decoration: none !important; color: #98BF92 !important; opacity: 1 !important;">K-STATE COURSEWORK</a>
        <span style="color: #98BF92 !important; opacity: 1 !important;">/</span> 
        <span style="color: #98BF92 !important; text-transform: uppercase !important; font-weight: 600 !important; opacity: 1 !important;">{frontmatter.title || "Document"}</span>
      </nav>

      <article class="prose prose-invert" style="line-height: 1.7; color: rgba(255,255,255,0.85);">
        <Content />
      </article>

    </div>
  </main>
</SiteLayout>

<style is:global>
  article h1 { font-size: 2.25rem; font-weight: 700; color: #ffffff; margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 0.5rem; }
  article h2 { font-size: 1.5rem; font-weight: 600; color: #98BF92; margin-top: 2.5rem; margin-bottom: 1rem; font-family: monospace; }
  article h3 { font-size: 1.25rem; font-weight: 600; color: #ffffff; margin-top: 1.75rem; margin-bottom: 0.7rem; }
  article p { margin-bottom: 1.5rem; color: rgba(255, 255, 255, 0.8); line-height: 1.75; }
  article ul, article ol { margin-left: 1.5rem; margin-bottom: 1.5rem; color: rgba(255, 255, 255, 0.8); }
  article li { margin-bottom: 0.5rem; line-height: 1.6; }
  article code { font-family: monospace; background-color: rgba(255,255,255,0.07); padding: 2px 6px; border-radius: 4px; color: #98BF92; }
</style>