---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Más Wild Labs // System Integrity" description="Ensuring critical infrastructure resilience, backend optimization, and absolute system integrity.">
  <main style="background-color: #141414; min-height: 100vh; color: #ffffff; padding-bottom: 6rem; position: relative; z-index: 40; pointer-events: auto;">
    
    <div style="max-width: 80rem; margin-left: auto; margin-right: auto; padding-left: 1.5rem; padding-right: 1.5rem; padding-top: 4rem; padding-bottom: 1rem;">
      <h2 style="font-family: monospace; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: #98BF92; margin-bottom: 1.5rem;">
        // Academic & System Architecture
      </h2>
      
      <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));">
        
        <a href="/capstone" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.1); background-color: rgba(28,28,28,0.4); border-radius: 0.75rem; padding: 1.5rem; min-height: 240px; text-decoration: none; cursor: pointer; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#98BF92'" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
          <div>
            <span style="display: inline-block; font-size: 10px; font-family: monospace; color: rgba(255,255,255,0.4); text-transform: uppercase; margin-bottom: 0.5rem;">Core Index</span>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #ffffff; margin: 0;">Document Design Capstone</h3>
            <p style="margin-top: 0.75rem; font-size: 0.875rem; color: rgba(255,255,255,0.6); line-height: 1.6;">Comprehensive engineering index exploring brand architecture, visual design matrices, and usability safety nets.</p>
          </div>
          <div style="margin-top: 1.5rem; font-size: 11px; font-family: monospace; color: #98BF92;">OPEN MODULE MATRIX →</div>
        </a>

        <a href="/oralcapstone" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.1); background-color: rgba(28,28,28,0.4); border-radius: 0.75rem; padding: 1.5rem; min-height: 240px; text-decoration: none; cursor: pointer; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#98BF92'" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
          <div>
            <span style="display: inline-block; font-size: 10px; font-family: monospace; color: rgba(255,255,255,0.4); text-transform: uppercase; margin-bottom: 0.5rem;">Oral Defense</span>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #ffffff; margin: 0;">Oral Capstone Presentation</h3>
            <p style="margin-top: 0.75rem; font-size: 0.875rem; color: rgba(255,255,255,0.6); line-height: 1.6;">Recorded technical presentation video stream and comprehensive academic milestone reflections.</p>
          </div>
          <div style="margin-top: 1.5rem; font-size: 11px; font-family: monospace; color: #98BF92;">STREAM PRESENTATION →</div>
        </a>

        <a href="/kstate" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.1); background-color: rgba(28,28,28,0.4); border-radius: 0.75rem; padding: 1.5rem; min-height: 240px; text-decoration: none; cursor: pointer; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#98BF92'" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
          <div>
            <span style="display: inline-block; font-size: 10px; font-family: monospace; color: rgba(255,255,255,0.4); text-transform: uppercase; margin-bottom: 0.5rem;">University Track</span>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #ffffff; margin: 0;">K-State Coursework</h3>
            <p style="margin-top: 0.75rem; font-size: 0.875rem; color: rgba(255,255,255,0.6); line-height: 1.6;">Central repository for specialized academic deliverables, technical proposals, and course milestone documentations.</p>
          </div>
          <div style="margin-top: 1.5rem; font-size: 11px; font-family: monospace; color: #98BF92;">EXPLORE ASSIGNMENTS →</div>
        </a>

      </div>
    </div>

    <div style="max-width: 80rem; margin-left: auto; margin-right: auto; padding-left: 1.5rem; padding-right: 1.5rem; padding-top: 3rem; padding-bottom: 1rem;">
      <h2 style="font-family: sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #ffffff;">
        Active Projects
      </h2>
    </div>

    <div style="max-width: 80rem; margin-left: auto; margin-right: auto; padding-left: 1.5rem; padding-right: 1.5rem; margin-top: 1rem;">
      <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));">
        
        <a href="/tools/systems-lab-build" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.15); background-color: #1c1c1c; border-radius: 0.75rem; padding: 1.5rem; min-height: 340px; text-decoration: none; cursor: pointer; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#98BF92'" onmouseout="this.style.borderColor='rgba(255,255,255,0.15)'">
          <div>
            <span style="display: inline-block; font-size: 10px; font-family: monospace; border: 1px solid rgba(152,191,146,0.3); background-color: rgba(152,191,146,0.1); color: #98BF92; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; margin-bottom: 1rem;">Operational</span>
            <h3 style="font-size: 1.25rem; font-weight: 700; text-transform: uppercase; color: #ffffff; margin: 0;">Systems Lab Build</h3>
            <p style="margin-top: 1rem; font-size: 0.875rem; color: rgba(255,255,255,0.5); line-height: 1.6;">Core Proxmox VE hypervisor cluster, isolated virtual network architectures, and robust Docker environment automation frameworks.</p>
          </div>
          <div style="margin-top: 2rem; font-size: 11px; font-family: monospace; color: #98BF92;">Project Specs →</div>
        </a>

        <a href="/under-construction" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.1); background-color: rgba(28,28,28,0.4); border-radius: 0.75rem; padding: 1.5rem; min-height: 340px; text-decoration: none; cursor: pointer; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#eab308'" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
          <div>
            <span style="display: inline-block; font-size: 10px; font-family: monospace; border: 1px solid rgba(234,179,8,0.3); background-color: rgba(234,179,8,0.1); color: #eab308; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; margin-bottom: 1rem;">Development</span>
            <h3 style="font-size: 1.25rem; font-weight: 700; text-transform: uppercase; color: #ffffff; margin: 0;">STE Compliance Tool</h3>
            <p style="margin-top: 1rem; font-size: 0.875rem; color: rgba(255,255,255,0.5); line-height: 1.6;">Automated ASD-STE100 compliance validation engine designed to reduce technical writing ambiguity and streamline editing workflows.</p>
          </div>
          <div style="margin-top: 2rem; font-size: 11px; font-family: monospace; color: #eab308;">Under Construction →</div>
        </a>

        <a href="/under-construction" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.1); background-color: rgba(28,28,28,0.4); border-radius: 0.75rem; padding: 1.5rem; min-height: 340px; text-decoration: none; cursor: pointer; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#eab308'" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)'">
          <div>
            <span style="display: inline-block; font-size: 10px; font-family: monospace; border: 1px solid rgba(234,179,8,0.3); background-color: rgba(234,179,8,0.1); color: #eab308; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; margin-bottom: 1rem;">Development</span>
            <h3 style="font-size: 1.25rem; font-weight: 700; text-transform: uppercase; color: #ffffff; margin: 0;">Text-to-Markdown</h3>
            <p style="margin-top: 1rem; font-size: 0.875rem; color: rgba(255,255,255,0.5); line-height: 1.6;">A slick, real-time conversion utility built to translate unstructured plain-text documentation into clean Markdown payloads.</p>
          </div>
          <div style="margin-top: 2rem; font-size: 11px; font-family: monospace; color: #eab308;">Under Construction →</div>
        </a>

        <a href="/tools/security-audit" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.15); background-color: #1c1c1c; border-radius: 0.75rem; padding: 1.5rem; min-height: 340px; text-decoration: none; cursor: pointer; transition: border-color 0.3s;" onmouseover="this.style.borderColor='#98BF92'" onmouseout="this.style.borderColor='rgba(255,255,255,0.15)'">
          <div>
            <span style="display: inline-block; font-size: 10px; font-family: monospace; border: 1px solid rgba(239,68,68,0.3); background-color: rgba(239,68,68,0.1); color: #ef4444; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; margin-bottom: 1rem;">Mitigation</span>
            <h3 style="font-size: 1.25rem; font-weight: 700; text-transform: uppercase; color: #ffffff; margin: 0;">Security Audit</h3>
            <p style="margin-top: 1rem; font-size: 0.875rem; color: rgba(255,255,255,0.5); line-height: 1.6;">Active perimeter vulnerability scanning, isolated VLAN firewall validation, and strict access-control system hardening audits.</p>
          </div>
          <div style="margin-top: 2rem; font-size: 11px; font-family: monospace; color: #98BF92;">Project Specs →</div>
        </a>

      </div>
    </div>

  </main>
</SiteLayout>