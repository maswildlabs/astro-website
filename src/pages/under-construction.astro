---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Más Wild Labs // Under Construction" description="Our engineering crew is actively patching this module.">
  <main style="background-color: #141414; min-height: 100vh; color: #ffffff; display: flex; align-items: center; justify-content: center; padding: 2rem 1.5rem; position: relative; z-index: 40;">
    
    <div style="border: 1px solid rgba(152, 191, 146, 0.2); background-color: rgba(152, 191, 146, 0.03); border-radius: 0.75rem; padding: 2.5rem; text-align: center; max-width: 44rem; width: 100%;">
      <h2 style="font-family: sans-serif; font-size: 2rem; font-weight: 800; color: #ffffff; margin: 0 0 0.5rem 0; letter-spacing: -0.025em;">
        Module Under <span style="color: #98BF92;">Construction</span>
      </h2>
      <p style="color: rgba(255,255,255,0.6); font-size: 0.95rem; margin: 0 auto 2rem auto; line-height: 1.6;">
        Things are brewing! The Busytown engineering crew is deep in the sub-routines refactoring this documentation module.
      </p>
      
      <img 
        src="/images/under-construction.png" 
        alt="Richard Scarry Busytown crew working in the lab" 
        style="width: 100%; max-width: 600px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 10px 30px rgba(0,0,0,0.5); margin-bottom: 2rem;"
      />

      <div>
        <a href="/" style="display: inline-block; font-family: monospace; font-size: 13px; color: #141414; background-color: #98BF92; padding: 0.75rem 1.5rem; border-radius: 0.375rem; text-decoration: none; font-weight: 700; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#b3dcae'" onmouseout="this.style.backgroundColor='#98BF92'">
          ← RETURN TO SYSTEM CORE
        </a>
      </div>
    </div>

  </main>
</SiteLayout>